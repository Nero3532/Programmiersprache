  "description": "tree-sitter-Grammatik für die Programmiersprache Deutsch",
  "license": "GPL-3.0-or-later",
  "main": "bindings/node",
  "keywords": ["parser", "tree-sitter", "deutsch"],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test"
