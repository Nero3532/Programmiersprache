{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Deutsch",
  "scopeName": "source.deutsch",
  "patterns": [
    { "include": "#kommentar" },
    { "include": "#zeichenkette3" },
    { "include": "#zeichenkette" },
    { "include": "#dekorator" },
    { "include": "#definition" },
    { "include": "#konstante" },
    { "include": "#schluesselwort" },
    { "include": "#fehlerart" },
    { "include": "#zahl" },
    { "include": "#operator" }
  ],
  "repository": {
    "kommentar": { "name": "comment.line.number-sign.deutsch", "match": "#.*$" },
    "dekorator": { "name": "entity.name.decorator.deutsch", "match": "@[\\p{L}_][\\p{L}\\p{N}_.]*" },
    "definition": {
      "match": "\\b(funktion|klasse)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "keyword.control.deutsch" },
        "2": { "name": "entity.name.function.deutsch" }
      }
    },
    "konstante": { "name": "constant.language.deutsch", "match": "\\b(wahr|falsch|nichts)\\b" },
    "schluesselwort": {
      "name": "keyword.control.deutsch",
      "match": "\\b(sei|wenn|sonst|solange|für|fuer|in|funktion|zurück|zurueck|und|oder|nicht|klasse|aufzaehlung|aufzählung|neu|abbrechen|weiter|versuche|fange|endlich|lade|passe|fall|werfe|pruefe|konstante|statisch|als)\\b"
    },
    "fehlerart": {
      "name": "support.class.exception.deutsch",
      "match": "\\b(Fehler|TypFehler|WertFehler|NamensFehler|IndexFehler|SchluesselFehler|AttributFehler|DateiFehler|SyntaxFehler|LaufzeitFehler|RekursionsFehler|ZusicherungsFehler|ImportFehler|EingabeEndeFehler|DivisionDurchNullFehler|UeberlaufFehler)\\b"
    },
    "zahl": {
      "patterns": [
        { "name": "constant.numeric.hex.deutsch", "match": "\\b0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*\\b" },
        { "name": "constant.numeric.binary.deutsch", "match": "\\b0[bB][01]+(?:_[01]+)*\\b" },
        { "name": "constant.numeric.octal.deutsch", "match": "\\b0[oO][0-7]+(?:_[0-7]+)*\\b" },
        { "name": "constant.numeric.decimal.deutsch", "match": "\\b\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*)?(?:[eE][+-]?\\d+)?\\b" }
      ]
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.arrow.deutsch", "match": "->" },
        { "name": "keyword.operator.coalesce.deutsch", "match": "\\?\\?" },
        { "name": "keyword.operator.optional-chaining.deutsch", "match": "\\?\\." },
        { "name": "keyword.operator.deutsch", "match": "\\*\\*=?|//=?|<<=?|>>=?|[=!<>+\\-*/%&|^]=|[+\\-*/%<>=&|^~]" }
      ]
    },
    "escape": { "name": "constant.character.escape.deutsch", "match": "\\\\." },
    "interpolation": {
      "name": "meta.interpolation.deutsch",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.deutsch" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.deutsch" } },
      "patterns": [
        { "include": "#klammern" },
        { "include": "#zeichenkette" },
        { "include": "#konstante" },
        { "include": "#schluesselwort" },
        { "include": "#fehlerart" },
        { "include": "#zahl" },
        { "include": "#operator" }
      ]
    },
    "klammern": { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "#klammern" }, { "include": "#zahl" }, { "include": "#operator" }] },
    "zeichenkette": {
      "name": "string.quoted.double.deutsch",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "include": "#escape" }, { "include": "#interpolation" }]
    },
    "zeichenkette3": {
      "name": "string.quoted.triple.deutsch",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [{ "include": "#escape" }, { "include": "#interpolation" }]
    }
  }
}
